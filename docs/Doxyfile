# Doxygen configuration for delphi-edm4hep API docs.
# Built by the docs-build job in .github/workflows/ci.yml and deployed to
# GitHub Pages by docs-deploy (dev only). The build also runs on every PR.
# Local build (doxygen ships with the key4hep stack):
#   doxygen docs/Doxyfile        # from the repo root; output in docs/html
# Only options that differ from the doxygen defaults are listed.

PROJECT_NAME           = "delphi-edm4hep"
PROJECT_BRIEF          = "DELPHI SDST/FDST -> EDM4hep converter"
OUTPUT_DIRECTORY       = docs
GENERATE_LATEX         = NO

# The converter sources plus the markdown docs. The vendored PHDST/SKELANA
# wrapper headers (extern/) are third-party and deliberately not documented.
INPUT                  = README.md \
                         docs/README.md \
                         delphi_edm4hep/README.md \
                         scripts/data-reco/README.md \
                         delphi_edm4hep/extern/delphi-analysis/README.md \
                         delphi_edm4hep/include \
                         delphi_edm4hep/src \
                         delphi_edm4hep/bin
RECURSIVE              = YES
EXCLUDE                = delphi_edm4hep/extern/delphi-analysis/include
USE_MDFILE_AS_MAINPAGE = ./README.md
IMAGE_PATH             =

# The codebase is not (yet) doxygen-annotated; extract everything so the
# full API surface is browsable, with the source inline for reference.
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO

GENERATE_TREEVIEW      = YES
HTML_DYNAMIC_SECTIONS  = YES
FULL_SIDEBAR           = NO

HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

WARN_IF_UNDOCUMENTED   = NO
QUIET                  = YES

# The collection map is copied into the site root; CI renders it before
# the docs build.
HTML_EXTRA_FILES       = docs/collection-map/collection_map.html

# The collection map reads per-collection documentation tables out of this XML;
# `@collection{NAME}` on an enum says which collection it documents, and
# `@bits{NAME,SLOT}` attaches one enum to a single slot of another table.
GENERATE_XML           = YES
XML_OUTPUT             = xml
ALIASES               += "collection{1}=@par Collection^^\1"
ALIASES               += "bits{2}=@par Bits^^\1,\2"
